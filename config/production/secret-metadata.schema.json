{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "purpose",
      "keyId",
      "state",
      "notBefore",
      "expiresAt",
      "graceUntil"
    ],
    "properties": {
      "purpose": {
        "enum": [
          "DATABASE",
          "SQUARE_ACCESS",
          "SQUARE_WEBHOOK",
          "STORAGE",
          "GUEST_RECOVERY"
        ]
      },
      "keyId": {
        "type": "string",
        "pattern": "^[-a-zA-Z0-9_.]{1,100}$"
      },
      "state": {
        "enum": [
          "ACTIVE",
          "RETIRING",
          "REVOKED"
        ]
      },
      "notBefore": {
        "type": "string"
      },
      "expiresAt": {
        "type": "string"
      },
      "graceUntil": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "$comment": "Runtime validates timestamps, lifecycle bounds and exactly one active key per required purpose. This schema never stores secret material."
}
