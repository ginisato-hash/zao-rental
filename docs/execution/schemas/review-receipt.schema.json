{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "runId",
        "baseSha",
        "headSha",
        "specHash",
        "snapshotHash",
        "reviewHash"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^E[0-9]{2}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "specHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 100
    }
  }
}
