{
  "name": "zao-rental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.x",
    "npm": "11.12.x"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen apps/web && tsc --noEmit",
    "test:reference": "python3 -m unittest discover -s tests -p test_*.py -v",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts tests/automation/*.test.ts tests/catalog/*.test.ts",
    "test:integration": "node --import tsx scripts/integration.ts && node --import tsx scripts/ledger-integration.ts",
    "build": "next build apps/web --webpack",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "dev": "node --import tsx scripts/dev.ts",
    "runner:dry-run": "node --import tsx tools/automation/controller/dry-run.ts --dry-run",
    "check:reference": "node scripts/check-reference.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:controller:macos": "node --import tsx scripts/test-controller-macos.ts",
    "controller:export": "node --import tsx scripts/export-controller.ts",
    "test:auth": "node --import tsx tests/auth/staff-flow.ts",
    "test:inventory": "node --import tsx tests/inventory/real-postgres.ts",
    "test:holds-ui": "node --import tsx tests/inventory/normal-ui.ts",
    "test:transfer": "node --import tsx tests/transfer/real-postgres.ts",
    "test:transfers-ui": "node --import tsx tests/transfer/normal-ui.ts",
    "test:pricing": "node --import tsx tests/pricing/real-postgres.ts",
    "test:quotes-ui": "node --import tsx tests/pricing/normal-ui.ts",
    "test:recommendation": "node --import tsx tests/recommendation/real-postgres.ts",
    "test:recommendations-ui": "node --import tsx tests/recommendation/normal-ui.ts",
    "test:recommendation-audit": "node --import tsx tests/recommendation/audit-followup-ui.ts",
    "test:recommendation-continuation": "node --import tsx tests/recommendation/continuation-ui.ts",
    "test:stabilization-s01": "node --import tsx tests/stabilization/s01.ts",
    "test:stabilization-upgrade": "node --import tsx tests/stabilization/upgrade.ts",
    "test:stabilization-cd": "node --import tsx tests/stabilization/cd.ts",
    "test:stabilization-eg": "node --import tsx tests/stabilization/eg.ts",
    "test:stabilization-mixed": "node --import tsx tests/stabilization/mixed.ts",
    "test:flow-payment": "node --import tsx tests/flow/payment.ts",
    "test:flow-ui": "node --import tsx tests/flow/normal-ui.ts",
    "test:asset-reader": "node --import tsx tests/flow/asset-reader-ui.ts",
    "test:flow-restart": "node --import tsx tests/flow/web-restart.ts",
    "test:flow-scope-race": "node --import tsx tests/flow/scope-race.ts",
    "test:wear": "node --import tsx tests/wear/real-postgres.ts && node --import tsx tests/wear/group-capacity.ts",
    "test:wear-ui": "node --import tsx tests/wear/normal-ui.ts",
    "test:wear-mixed": "node --import tsx tests/wear/mixed.ts",
    "test:content-fixture": "node --import tsx tests/content/normal-ui.ts",
    "test:custody": "node --import tsx tests/custody/boundary-counterexample.ts && node --import tsx tests/custody/real-postgres.ts && node --import tsx tests/custody/scenarios.ts",
    "test:custody-ui": "node --import tsx tests/custody/normal-ui.ts",
    "test:late-pickup": "node --import tsx tests/custody/late-pickup.ts",
    "test:public-guest": "node --import tsx tests/public/guest-postgres.ts && node --import tsx tests/public/guest-integrated.ts",
    "test:public-content": "node --import tsx tests/public/content-postgres.ts",
    "test:public-ui": "node --import tsx tests/public/normal-ui.ts && node --import tsx tests/public/content-ui.ts",
    "demo:public": "node --import tsx tests/public/demo.ts",
    "test:readiness-guest": "node --import tsx tests/readiness/guest-security.ts",
    "test:readiness-ui": "node --import tsx tests/readiness/guest-ui.ts",
    "test:integration-p2": "node --import tsx tests/readiness/production-composition.ts && node --import tsx tests/readiness/backup-restore.ts",
    "test:square-activation": "node scripts/square-activation.mjs",
    "test:staff-diagnostic": "node --import tsx tests/readiness/staff-diagnostic.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "jsqr": "1.4.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
