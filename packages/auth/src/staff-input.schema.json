      },
      "active": {
        "type": "boolean"
      },
      "role": {
        "enum": [
          "ADMIN",
          "MANAGER",
          "STAFF",
          "VIEWER"
        ]
      },
      "scope": {
        "enum": [
          "ALL",
          "ASSIGNED"
        ]
      },
      "storeIds": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 2,
        "items": {
          "enum": [
            "MOUNTAIN_BASE",
            "ONSEN_BASE"
          ]
        }
      },
      "permissions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "STAFF_MANAGE": {
            "type": "boolean"
          },
          "INVENTORY_EDIT": {
            "type": "boolean"
          },
          "INVENTORY_VIEW": {
            "type": "boolean"
          },
