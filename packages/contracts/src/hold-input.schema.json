{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reservationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "pickupStore": {
      "enum": [
        "MOUNTAIN_BASE",
        "ONSEN_BASE"
      ]
    },
    "returnStore": {
      "enum": [
        "MOUNTAIN_BASE",
        "ONSEN_BASE"
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "slot": {
          "enum": [
            "AM",
            "PM",
            "DAY",
            "MULTIDAY"
          ]
        }
      },
      "required": [
        "startDate",
        "endDate",
        "slot"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,24}$"
          },
          "product": {
            "enum": [
              "SKI_SET",
              "SNOWBOARD_SET",
              "SINGLE",
              "WEAR_SET"
            ]
          },
          "age": {
            "enum": [
              "ADULT",
              "KIDS"
            ]
          },
          "tier": {
            "enum": [
              "REGULAR",
              "PREMIUM",
              "STANDARD"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "family": {
                  "enum": [
                    "SKI",
                    "SNOWBOARD",
                    "SKI_BOOT",
                    "SNOWBOARD_BOOT",
                    "POLE",
                    "WEAR_JACKET",
                    "WEAR_PANTS"
                  ]
                },
                "variantIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  }
                },
                "modelPromise": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "modelId",
                    "season",
                    "variantId"
                  ],
                  "properties": {
                    "modelId": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                    },
                    "variantId": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                    },
                    "season": {
                      "type": "string",
                      "pattern": "^20[0-9]{2}/[0-9]{2}$"
                    }
                  }
                }
              },
              "required": [
                "family",
                "variantIds"
              ]
            }
          },
          "wear": {
            "type": "boolean"
          },
          "wearSport": {
            "enum": [
              "SKI",
              "SNOWBOARD"
            ]
          }
        },
        "required": [
          "key",
          "product",
          "age",
          "tier",
          "items"
        ]
      }
    },
    "contractVersion": {
      "const": "INTEGRATED_V1_2"
    }
  },
  "required": [
    "reservationId",
    "pickupStore",
    "returnStore",
    "period",
    "members"
  ]
}
