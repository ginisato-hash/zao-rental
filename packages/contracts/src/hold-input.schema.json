{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reservationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "pickupStore": {
      "enum": [
        "MOUNTAIN_BASE",
        "ONSEN_BASE"
      ]
    },
    "returnStore": {
      "enum": [
        "MOUNTAIN_BASE",
        "ONSEN_BASE"
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "slot": {
          "enum": [
            "AM",
            "PM",
            "DAY",
            "MULTIDAY"
          ]
        }
      },
      "required": [
        "startDate",
        "endDate",
        "slot"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,24}$"
          },
          "product": {
            "enum": [
              "SKI_SET",
              "SNOWBOARD_SET",
              "SINGLE"
            ]
          },
          "age": {
            "enum": [
              "ADULT",
              "KIDS"
            ]
          },
          "tier": {
            "enum": [
              "REGULAR",
              "PREMIUM"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "family": {
                  "enum": [
                    "SKI",
                    "SNOWBOARD",
                    "SKI_BOOT",
                    "SNOWBOARD_BOOT",
                    "POLE"
                  ]
                },
                "variantIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  }
                }
              },
              "required": [
                "family",
                "variantIds"
              ]
            }
          }
        },
        "required": [
          "key",
          "product",
          "age",
          "tier",
          "items"
        ]
      }
    }
  },
  "required": [
    "reservationId",
    "pickupStore",
    "returnStore",
    "period",
    "members"
  ]
}
