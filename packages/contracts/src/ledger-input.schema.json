          "maxLength": 160,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "compatibleSports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SKI",
              "SNOWBOARD"
            ]
          }
        }
      },
      "required": [
        "modelId",
        "family",
        "age",
        "tier",
        "size",
        "notes",
