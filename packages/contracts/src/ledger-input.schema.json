{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "models_create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{1,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "brand": {
          "type": "string",
          "maxLength": 80
        },
        "family": {
          "type": "string",
          "enum": [
            "SKI",
            "SNOWBOARD",
            "SKI_BOOT",
            "SNOWBOARD_BOOT",
            "POLE",
            "WEAR",
            "WEAR_JACKET",
            "WEAR_PANTS"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "SYNTHETIC",
            "UNVERIFIED"
          ]
        },
        "sourceDocument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "sourceLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "catalogSeason": {
          "type": "string",
          "pattern": "^20[0-9]{2}/[0-9]{2}$"
        }
      },
      "required": [
        "code",
        "name",
        "brand",
        "family",
        "notes",
        "sourceKind",
        "sourceDocument",
        "sourceLocator"
      ]
    },
    "models_update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
