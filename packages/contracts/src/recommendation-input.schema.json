{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pickupStore": {
      "enum": [
        "MOUNTAIN_BASE",
        "ONSEN_BASE"
      ]
    },
    "returnStore": {
      "enum": [
        "MOUNTAIN_BASE",
        "ONSEN_BASE"
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "slot": {
          "enum": [
            "AM",
            "PM",
            "DAY",
            "MULTIDAY"
          ]
        },
        "startAt": {
          "enum": [
            "08:30",
            "13:00"
          ]
        },
        "returnBy": {
          "enum": [
            "12:00",
            "17:00"
          ]
        }
      },
      "required": [
        "startDate",
        "endDate",
        "slot"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,24}$"
          },
          "sport": {
            "enum": [
              "SKI",
              "SNOWBOARD",
              "WEAR"
            ]
          },
          "heightCm": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 50,
                "maximum": 250
              },
              {
                "type": "null"
              }
            ]
          },
          "footCm": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 5,
                "maximum": 50,
                "multipleOf": 0.1
              },
              {
                "type": "null"
              }
            ]
          },
          "adultAtStart": {
            "type": "boolean"
          },
          "tier": {
            "enum": [
              "REGULAR",
              "PREMIUM",
              "STANDARD"
            ]
          },
          "ski": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "weightKg": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 300
                  },
                  "ageAtStart": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120
                  },
                  "level": {
                    "enum": [
                      "BEGINNER",
                      "INTERMEDIATE",
                      "ADVANCED"
                    ]
                  },
                  "skierType": {
                    "enum": [
                      "TYPE_I",
                      "TYPE_II",
                      "TYPE_III"
                    ]
                  }
                },
                "required": [
                  "weightKg",
                  "ageAtStart"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "poleVariantId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "wearSelection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jacketVariantId",
              "pantsVariantId"
            ],
            "properties": {
              "jacketVariantId": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "pantsVariantId": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              }
            }
          },
          "wearSport": {
            "enum": [
              "SKI",
              "SNOWBOARD"
            ]
          },
          "modelSelection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "season"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "season": {
                "type": "string",
                "pattern": "^20[0-9]{2}/[0-9]{2}$"
              }
            }
          },
          "itemFamily": {
            "enum": [
              "SKI",
              "SKI_BOOT",
              "SNOWBOARD",
              "SNOWBOARD_BOOT",
              "POLE"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "SKI",
                "SKI_BOOT",
                "SNOWBOARD",
                "SNOWBOARD_BOOT",
                "POLE"
              ]
            }
          }
        },
        "required": [
          "key",
          "sport",
          "heightCm",
          "footCm",
          "adultAtStart",
          "tier",
          "ski"
        ]
      }
    },
    "contractVersion": {
      "enum": [
        "INTEGRATED_V1_2",
        "INTEGRATED_V1_3",
        "INTEGRATED_V1_4"
      ]
    }
  },
  "required": [
    "pickupStore",
    "returnStore",
    "period",
    "members"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "contractVersion": {
            "enum": [
              "INTEGRATED_V1_3",
              "INTEGRATED_V1_4"
            ]
          }
        },
        "required": [
          "contractVersion"
        ]
      },
      "then": {
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ski": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "weightKg": {
                          "type": "integer"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
