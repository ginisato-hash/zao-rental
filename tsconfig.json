{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@rental/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@rental/core": [
        "packages/core/src/index.ts"
      ],
      "@rental/db": [
        "packages/db/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "tests/**/*.tsx",
    "apps/webhook-ingress/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web/.next"
  ]
}
